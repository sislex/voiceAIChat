# HTTPS-прокси для доступа по голому IP: браузеры дают микрофон (getUserMedia)
# только secure-контексту, поэтому наружу отдаём https:// с сертификатом
# локального CA Caddy (tls internal). Предупреждение браузера принимается один раз.
#
# Адрес НЕ зашивается в файл: он менялся при переезде (45.135.182.251 →
# 89.125.68.35), и захардкоженный хост уже привёл к расхождению — работающая
# конфигурация была загружена мимо файла, а сам файл остался со старым IP.
# Следующее пересоздание контейнера подняло бы Caddy со старым адресом, и https
# перестал бы отвечать. Значение приходит из .env рядом с docker-compose.yml.

{
	# При заходе по голому IP браузер не шлёт SNI — отдаём сертификат IP по умолчанию.
	default_sni {$VC_PUBLIC_HOST}
}

https://{$VC_PUBLIC_HOST} {
	tls internal
	# Local applications keep direct upstreams. Disabled/external applications
	# use Core so its deployment policy applies. Internal APIs stay private.
	handle /internal/* {
		respond 404
	}
	@playwright_reader path /api/browser /api/browser/*
	handle @playwright_reader {
		reverse_proxy {$VC_CADDY_PLAYWRIGHT_READER_UPSTREAM:playwright-reader:8797}
	}
	@make path /api/make /api/make/* /api/preview/make/* /api/preview/make-shared/* /p/* /s/*
	handle @make {
		reverse_proxy {$VC_CADDY_MAKE_UPSTREAM:make:8788}
	}
	@imageStudio path /api/image-studio /api/image-studio/* /g/*
	handle @imageStudio {
		reverse_proxy {$VC_CADDY_IMAGE_STUDIO_UPSTREAM:image-studio:8796}
	}
	handle {
		reverse_proxy voicechat:8787
	}
}

# Обычный HTTP на 80 порту — редирект на HTTPS.
http://{$VC_PUBLIC_HOST} {
	redir https://{host}{uri} permanent
}

# Внутреннее имя для сети compose. Нужно браузерному раннеру: до публичного IP
# собственного хоста контейнер не достаёт (ufw режет «контейнер → INPUT»), а
# подмена адреса алиасом меняет и SNI — Caddy получал имя, которого не знал, и
# отвечал ERR_SSL_PROTOCOL_ERROR. Здесь у этого имени есть свой сертификат того
# же локального CA, которому раннер уже доверяет.
https://caddy {
	tls internal
	# Local applications keep direct upstreams. Disabled/external applications
	# use Core so its deployment policy applies. Internal APIs stay private.
	handle /internal/* {
		respond 404
	}
	@playwright_reader path /api/browser /api/browser/*
	handle @playwright_reader {
		reverse_proxy {$VC_CADDY_PLAYWRIGHT_READER_UPSTREAM:playwright-reader:8797}
	}
	@make path /api/make /api/make/* /api/preview/make/* /api/preview/make-shared/* /p/* /s/*
	handle @make {
		reverse_proxy {$VC_CADDY_MAKE_UPSTREAM:make:8788}
	}
	@imageStudio path /api/image-studio /api/image-studio/* /g/*
	handle @imageStudio {
		reverse_proxy {$VC_CADDY_IMAGE_STUDIO_UPSTREAM:image-studio:8796}
	}
	handle {
		reverse_proxy voicechat:8787
	}
}

# Stand leases terminate TLS here; Core listeners remain HTTP inside Compose.
https://{$VC_PUBLIC_HOST}:8790, https://{$VC_PUBLIC_HOST}:8791, https://{$VC_PUBLIC_HOST}:8792, https://{$VC_PUBLIC_HOST}:8793, https://{$VC_PUBLIC_HOST}:8794 {
	tls internal
	reverse_proxy voicechat:{http.request.port}
}
