-/**
- * `codex exec --json` reports every agent message and the Codex sink concatenates them, so a
- * progress note («Проверю базу знаний…») ends up glued before the final JSON. Claude reports
- * only the final message. For Codex take the last complete agent message when it is the tail of
- * the response and is itself valid JSON; otherwise keep the full text and the strict format rules.
- */
-export function finalAgentMessage(provider: string, fullText: string, lastChunk: string): string {
-  if (provider !== 'codex' || !lastChunk || lastChunk === fullText || !fullText.endsWith(lastChunk)) return fullText
-  const candidate = lastChunk.trim()
-  if (!candidate.startsWith('{') || !candidate.endsWith('}')) return fullText
-  try { JSON.parse(candidate) } catch { return fullText }
-  return candidate
+/** Every provider must validate the full response, including earlier messages. */
+export function finalAgentMessage(_provider: string, fullText: string, _lastChunk: string): string {
+  return fullText
 }
