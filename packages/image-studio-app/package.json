{
  "name": "@voicechat/image-studio-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts",
    "./components/*": "./src/components/*.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./panelContract": "./src/panelContract.ts",
    "./styles.css": "./src/panel.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --silent",
    "build": "node --import tsx ../../scripts/application-frontend.mjs image-studio-ui",
    "dev": "node --import tsx ../../scripts/application-frontend-dev.mjs image-studio-ui"
  },
  "dependencies": {
    "@voicechat/shared": "*",
    "@voicechat/ui-kit": "*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@voicechat/ui-foundation": "*"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "^4.12.1",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2"
  }
}
