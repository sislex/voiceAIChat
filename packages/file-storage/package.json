{
  "name": "@sislexa/file-storage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node/server.ts",
    "./node/main": "./src/node/main.ts"
  },
  "files": [
    "src",
    "component-contract.json"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --silent",
    "start": "node --import tsx src/node/main.ts"
  },
  "dependencies": {
    "@voicechat/shared": "*",
    "@sislexa/component-runtime": "*",
    "fastify": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "tsx": "^4.19.2"
  }
}
