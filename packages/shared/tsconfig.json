{
  "compilerOptions": {
    // Инкрементальный typecheck: tsc держит tsconfig.tsbuildinfo рядом с конфигом
    // (он в .gitignore) и на тёплом кеше отвечает за секунду вместо десяти.
    "incremental": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "declaration": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
