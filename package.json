{
  "name": "voicechat-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Голосовой чат-бот: desktop (Electron), server (STT/TTS/Claude), web-клиент",
  "//": "Electron applications are released by sislex/agent and sislex/desktop; Core consumes pinned artifacts.",
  "workspaces": [
    "packages/shared",
    "packages/knowledge",
    "packages/component-runtime",
    "packages/file-storage",
    "apps/automation-runner",
    "apps/server"
  ],
  "scripts": {
    "dev:gateway": "node --import tsx scripts/dev-gateway.mjs",
    "dev:component": "node scripts/dev-component.mjs",
    "dev:stand": "node scripts/dev-stand-local.mjs start",
    "dev:stand:run": "node scripts/dev-stand-local.mjs run",
    "dev:stand:status": "node scripts/dev-stand-local.mjs status",
    "dev:stand:stop": "node scripts/dev-stand-local.mjs stop",
    "dev:web": "bash scripts/dev-web.sh",
    "kb": "node packages/kb-tools/cli.mjs",
    "kb:check": "node packages/kb-tools/cli.mjs check",
    "kb:index": "node packages/kb-tools/cli.mjs index",
    "kb:log": "node packages/kb-tools/cli.mjs log",
    "typecheck": "npm run typecheck:kb-tools && npm run typecheck --workspaces --if-present",
    "test": "npm run test:tooling && npm run test --workspaces --if-present",
    "affected-check": "node --import tsx scripts/application-gate.mjs",
    "frontend:static": "node scripts/core-ui-artifact.mjs",
    "frontend:build-gates": "npm run build:frontends && npm run verify:core-ui && npm run frontend:route-gates",
    "frontend:route-gates": "node scripts/full-gate.mjs --routes",
    "verify:frontend": "npm run frontend:build-gates",
    "build": "npm run verify:core-ui",
    "verify": "npm run typecheck && npm test && npm run verify:frontend",
    "gate": "npm run gate:changed",
    "//gate:fast": "Проверки изменённых приложений рабочего дерева; общие контракты и неизвестные пути расширяют выбор. gate:all — полный гейт.",
    "gate:fast": "node --import tsx scripts/application-gate.mjs --worktree",
    "vendor:fetch": "node scripts/vendor-store.mjs fetch",
    "vendor:publish": "node scripts/vendor-store.mjs publish",
    "vendor:check": "node scripts/vendor-store.mjs check",
    "gate:fast:logged": "node scripts/long-run.mjs start -- npm run gate:fast",
    "gate:status": "node scripts/long-run.mjs status",
    "test:coverage": "npm run -w @voicechat/shared test -- --coverage && npm run -w @voicechat/server test -- --coverage",
    "docker": "python3 scripts/prod/compose_env.py run -- up --build -d",
    "docker:down": "docker compose down",
    "kb:prepare": "node packages/kb-tools/cli.mjs prepare",
    "kb:verify-prepared": "node packages/kb-tools/cli.mjs verify",
    "kb:search": "node packages/kb-tools/cli.mjs search",
    "kb:context": "node packages/kb-tools/cli.mjs context",
    "kb:impact": "node packages/kb-tools/cli.mjs impact",
    "e2e:projects": "vitest run --config e2e/vitest.config.ts e2e/projects.e2e.test.ts",
    "e2e:settings": "vitest run --config e2e/vitest.config.ts e2e/settings.e2e.test.ts",
    "e2e:sessions": "vitest run --config e2e/vitest.config.ts e2e/sessions.e2e.test.ts",
    "e2e:git": "vitest run --config e2e/vitest.config.ts e2e/gitPane.e2e.test.ts",
    "e2e:kanban-stand": "node scripts/kanban-stand-prepare.mjs",
    "browser-runner:local": "bash scripts/browser-runner-local.sh up",
    "browser-runner:stop": "bash scripts/browser-runner-local.sh down",
    "reader:probe": "tsx scripts/reader-probe.mjs",
    "gate:all": "node scripts/full-gate.mjs",
    "gate:app": "node --import tsx scripts/application-gate.mjs",
    "gate:changed": "node --import tsx scripts/application-gate.mjs",
    "build:app": "node --import tsx scripts/application-build.mjs",
    "build:frontends": "node --import tsx scripts/application-frontend.mjs",
    "components:init": "node --import tsx scripts/component-installation.mjs",
    "components:rotate": "node --import tsx scripts/component-rotation.mjs",
    "components:token": "node --import tsx packages/component-runtime/src/cli.ts",
    "qa:voice-live": "vitest run --config e2e/vitest.live.config.ts",
    "verify:core-ui": "node scripts/core-ui-artifact.mjs",
    "build:core-contracts": "node scripts/core-contracts-release.mjs",
    "test:storybook": "npm run verify:core-ui",
    "test:tooling": "npm test --prefix packages/kb-tools && node --import tsx --test scripts/stand-diagnostics.test.mjs scripts/release-train.test.mjs scripts/release-train-run.test.mjs scripts/dev-stand.test.mjs scripts/dev-stand-local.test.mjs scripts/quick-gate.test.mjs scripts/task-gate.test.mjs scripts/task-tests.test.mjs scripts/test-files.test.mjs scripts/core-contracts-release.test.mjs scripts/shared-chat-artifacts.test.mjs scripts/s3-provider-artifacts.test.mjs scripts/browser-ui-release.test.mjs scripts/application-gate.test.mjs scripts/owner-pins.test.mjs scripts/vendor-archives.test.mjs scripts/vendor-store.test.mjs scripts/contracts-release.test.mjs scripts/release-composition.test.mjs scripts/release-gate.test.mjs scripts/mark-full-gate.test.mjs scripts/promotion-gate.test.mjs scripts/application-build.test.mjs scripts/owner-application-release.test.mjs scripts/application-frontend.test.mjs scripts/application-deploy.test.mjs scripts/delivery-release.test.mjs scripts/application-compatibility.test.mjs scripts/application-links.test.mjs scripts/component-installation.test.mjs scripts/component-rotation.test.mjs scripts/component-readiness.test.mjs scripts/operations-restore-drill.test.mjs scripts/operations-backup-retention.test.mjs && node --test scripts/ensure-playwright-browser.test.mjs scripts/affected-check.test.mjs scripts/merge-gate.test.mjs scripts/core-ui-artifact.test.mjs scripts/route-budgets.test.mjs scripts/route-compression.test.mjs scripts/full-gate.test.mjs scripts/browser-gate.test.mjs scripts/kanban-stand-prepare.test.mjs scripts/long-run.test.mjs scripts/system-gate.test.mjs && npm run gate:a07 && PYTHONDONTWRITEBYTECODE=1 python3 scripts/prod/test_local_image_pins.py && PYTHONDONTWRITEBYTECODE=1 python3 scripts/prod/test_owner_image_switches.py && PYTHONDONTWRITEBYTECODE=1 python3 scripts/prod/test_environment_scripts.py && PYTHONDONTWRITEBYTECODE=1 python3 scripts/prod/release_retention_test.py",
    "operations:restore-drill": "node scripts/operations-restore-drill.mjs",
    "operations:backup-retention": "node scripts/operations-backup-retention.mjs",
    "gate:audit": "node --import tsx scripts/gate-audit.mjs",
    "test:browser": "node scripts/browser-gate.mjs --integration",
    "e2e:tools": "vitest run --config e2e/vitest.config.ts e2e/toolIntegration.e2e.test.ts",
    "gate:system": "node scripts/system-gate.mjs",
    "gate:promotion": "node scripts/promotion-gate.mjs",
    "gate:release": "node --import tsx scripts/release-gate.mjs",
    "gate:release:full": "npm run gate:all && npm run gate:performance && npm run gate:system",
    "gate:merge": "node scripts/merge-gate.mjs",
    "gate:performance": "npm run frontend:route-gates",
    "ui:release": "node --import tsx scripts/browser-ui-release.mjs",
    "gate:shared-chat": "node --import tsx scripts/shared-chat-gate.mjs",
    "gate:a07": "node --import tsx --test scripts/a07-acceptance.test.mjs",
    "gate:quick": "node --import tsx scripts/quick-gate.mjs",
    "test:files": "node scripts/test-files.mjs",
    "kb:touch": "node packages/kb-tools/cli.mjs touch",
    "pack:kb-tools": "node scripts/kb-tools-release.mjs",
    "typecheck:kb-tools": "npm run typecheck --prefix packages/kb-tools && tsc --noEmit --allowJs --checkJs --target es2022 --module nodenext --skipLibCheck scripts/kb-tools-release.mjs scripts/kb.mjs scripts/kb-search.mjs",
    "gate:task": "node --import tsx scripts/task-gate.mjs"
  },
  "devDependencies": {
    "@sislex/runner-contracts": "https://github.com/sislex/voiceAIChat/releases/download/vendor/sislex-runner-contracts-0.1.3-5b7a9498cd40.tgz",
    "@sislexa/billing": "https://github.com/sislex/voiceAIChat/releases/download/vendor/sislexa-billing-1.2.4-56b4cbab3a33.tgz",
    "@sislexa/identity": "https://github.com/sislex/voiceAIChat/releases/download/vendor/sislexa-identity-1.5.2-d3e0e16d58cd.tgz",
    "@sislexa/image-studio": "https://github.com/sislex/voiceAIChat/releases/download/vendor/sislexa-image-studio-1.1.2-c7a49a428d85.tgz",
    "@sislexa/make": "https://github.com/sislex/voiceAIChat/releases/download/vendor/sislexa-make-1.8.6-dceea22b7443.tgz",
    "@sislexa/playwright-reader": "https://github.com/sislex/voiceAIChat/releases/download/vendor/sislexa-playwright-reader-1.2.7-871368b57ff9.tgz",
    "@sislexa/sdk": "https://github.com/sislex/voiceAIChat/releases/download/vendor/sislexa-sdk-1.2.0-354b8e560bac.tgz",
    "@sislexa/voice": "https://github.com/sislex/voiceAIChat/releases/download/vendor/sislexa-voice-1.1.2-9f8925b2fae1.tgz",
    "@sislexa/web-reader": "https://github.com/sislex/voiceAIChat/releases/download/vendor/sislexa-web-reader-1.3.6-56da8966af79.tgz",
    "@vitest/coverage-v8": "2.1.9",
    "@voicechat/browser-contracts": "https://github.com/sislex/voiceAIChat/releases/download/vendor/voicechat-browser-contracts-1.1.0-a6eaee6e0818.tgz",
    "@voicechat/image-studio-contracts": "https://github.com/sislex/voiceAIChat/releases/download/vendor/voicechat-image-studio-contracts-1.0.0-c7a49a428d85.tgz",
    "@voicechat/make-contracts": "https://github.com/sislex/voiceAIChat/releases/download/vendor/voicechat-make-contracts-1.8.6-730f9c24ef67.tgz",
    "@voicechat/playwright-reader-contracts": "https://github.com/sislex/voiceAIChat/releases/download/vendor/voicechat-playwright-reader-contracts-1.2.0-22032878622c.tgz",
    "@voicechat/ui-foundation": "https://github.com/sislex/voiceAIChat/releases/download/vendor/voicechat-ui-foundation-0.1.8-e5b4ef76c06b-fcfeefb8a485.tgz",
    "@voicechat/ui-kit": "https://github.com/sislex/voiceAIChat/releases/download/vendor/voicechat-ui-kit-0.1.3-ec8ba8f62d43.tgz",
    "@voicechat/voice-contracts": "https://github.com/sislex/voiceAIChat/releases/download/vendor/voicechat-voice-contracts-1.0.0-0e65038616a6.tgz",
    "@voicechat/web-reader-contracts": "https://github.com/sislex/voiceAIChat/releases/download/vendor/voicechat-web-reader-contracts-1.3.0-35c57a4fd913.tgz",
    "@sislexa/agent-contracts": "https://github.com/sislex/voiceAIChat/releases/download/vendor/sislexa-agent-contracts-1.5.0-3117b819912f.tgz",
    "@sislexa/agent": "https://github.com/sislex/voiceAIChat/releases/download/vendor/sislexa-agent-0.25.0-a4c1407f5494.tgz",
    "electron": "33.4.11",
    "@sislexa/desktop": "https://github.com/sislex/voiceAIChat/releases/download/vendor/sislexa-desktop-1.0.41-963bc96aef9e.tgz",
    "@sislexa/core-ui": "https://github.com/sislex/voiceAIChat/releases/download/vendor/sislexa-core-ui-1.5.34-1174017e8b25.tgz",
    "@sislexa/analytics": "https://github.com/sislex/voiceAIChat/releases/download/vendor/sislexa-analytics-1.3.0-058c5ebed59f.tgz",
    "tar-stream": "2.2.0",
    "@sislexa/chat-ui": "https://github.com/sislex/voiceAIChat/releases/download/vendor/sislexa-chat-ui-0.2.0-29f9fbf79e29.tgz",
    "@voicechat/chat-app": "https://github.com/sislex/voiceAIChat/releases/download/vendor/voicechat-chat-app-0.2.0-29f9fbf79e29.tgz",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "@sislex/llm-runner": "https://github.com/sislex/voiceAIChat/releases/download/vendor/sislex-llm-runner-0.3.8-a1063160bde1.tgz"
  },
  "overrides": {
    "@sislexa/agent-contracts": "$@sislexa/agent-contracts",
    "@sislexa/chat-ui": {
      "@sislexa/identity": "$@sislexa/identity",
      "@voicechat/shared": "0.1.42"
    },
    "sharp": "0.35.5",
    "@voicechat/chat-app": {
      "@voicechat/shared": "0.1.42"
    }
  }
}
