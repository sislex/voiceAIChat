{
  "name": "voicechat-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Голосовой чат-бот: desktop (Electron), server (STT/TTS/Claude), web-клиент",
  "//": "Electron applications are released by sislex/agent and sislex/desktop; Core consumes pinned artifacts.",
  "workspaces": [
    "packages/*",
    "apps/automation-runner",
    "apps/server"
  ],
  "scripts": {
    "dev:web": "bash scripts/dev-web.sh",
    "kb": "node scripts/kb.mjs",
    "kb:check": "node scripts/kb.mjs check",
    "kb:index": "node scripts/kb.mjs index",
    "kb:log": "node scripts/kb.mjs log",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test:tooling && npm run test --workspaces --if-present",
    "affected-check": "node --import tsx scripts/application-gate.mjs",
    "frontend:static": "node scripts/core-ui-artifact.mjs",
    "frontend:build-gates": "npm run build:frontends && npm run verify:core-ui && npm run frontend:route-gates",
    "frontend:route-gates": "node scripts/full-gate.mjs --routes",
    "verify:frontend": "npm run frontend:build-gates",
    "build": "npm run verify:core-ui",
    "verify": "npm run typecheck && npm test && npm run verify:frontend",
    "gate": "npm run gate:changed",
    "//gate:fast": "Проверки изменённых приложений рабочего дерева; общие контракты и неизвестные пути расширяют выбор. gate:all — полный гейт.",
    "gate:fast": "node --import tsx scripts/application-gate.mjs --worktree",
    "gate:fast:logged": "node scripts/long-run.mjs start -- npm run gate:fast",
    "gate:status": "node scripts/long-run.mjs status",
    "test:coverage": "npm run -w @voicechat/shared test -- --coverage && npm run -w @voicechat/server test -- --coverage",
    "docker": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "kb:prepare": "node scripts/kb-search.mjs prepare",
    "kb:verify-prepared": "node scripts/kb-search.mjs verify",
    "kb:search": "node scripts/kb-search.mjs search",
    "kb:context": "node scripts/kb-search.mjs context",
    "kb:impact": "node scripts/kb-search.mjs impact",
    "e2e:settings": "vitest run --config e2e/vitest.config.ts e2e/settings.e2e.test.ts",
    "e2e:sessions": "vitest run --config e2e/vitest.config.ts e2e/sessions.e2e.test.ts",
    "browser-runner:local": "bash scripts/browser-runner-local.sh up",
    "browser-runner:stop": "bash scripts/browser-runner-local.sh down",
    "reader:probe": "tsx scripts/reader-probe.mjs",
    "gate:all": "node scripts/full-gate.mjs",
    "gate:app": "node --import tsx scripts/application-gate.mjs",
    "gate:changed": "node --import tsx scripts/application-gate.mjs",
    "build:app": "node --import tsx scripts/application-build.mjs",
    "build:frontends": "node --import tsx scripts/application-frontend.mjs",
    "components:init": "node --import tsx scripts/component-installation.mjs",
    "components:token": "node --import tsx packages/component-runtime/src/cli.ts",
    "qa:voice-live": "vitest run --config e2e/vitest.live.config.ts",
    "verify:core-ui": "node scripts/core-ui-artifact.mjs",
    "build:core-contracts": "node scripts/core-contracts-release.mjs",
    "test:storybook": "npm run verify:core-ui",
    "test:tooling": "node --import tsx --test scripts/core-contracts-release.test.mjs scripts/shared-chat-artifacts.test.mjs scripts/s3-provider-artifacts.test.mjs scripts/browser-ui-release.test.mjs scripts/application-gate.test.mjs scripts/owner-pins.test.mjs scripts/release-composition.test.mjs scripts/release-gate.test.mjs scripts/application-build.test.mjs scripts/owner-application-release.test.mjs scripts/application-frontend.test.mjs scripts/application-deploy.test.mjs scripts/delivery-release.test.mjs scripts/application-compatibility.test.mjs scripts/application-links.test.mjs scripts/component-installation.test.mjs scripts/component-readiness.test.mjs scripts/operations-restore-drill.test.mjs scripts/operations-backup-retention.test.mjs && node --test scripts/affected-check.test.mjs scripts/merge-gate.test.mjs scripts/core-ui-artifact.test.mjs scripts/route-budgets.test.mjs scripts/route-compression.test.mjs scripts/full-gate.test.mjs scripts/browser-gate.test.mjs scripts/long-run.test.mjs scripts/system-gate.test.mjs && npm run gate:a07 && PYTHONDONTWRITEBYTECODE=1 python3 scripts/prod/test_local_image_pins.py && PYTHONDONTWRITEBYTECODE=1 python3 scripts/prod/release_retention_test.py",
    "operations:restore-drill": "node scripts/operations-restore-drill.mjs",
    "operations:backup-retention": "node scripts/operations-backup-retention.mjs",
    "gate:audit": "node --import tsx scripts/gate-audit.mjs",
    "test:browser": "node scripts/browser-gate.mjs --integration",
    "e2e:tools": "vitest run --config e2e/vitest.config.ts e2e/toolIntegration.e2e.test.ts",
    "gate:system": "node scripts/system-gate.mjs",
    "gate:release": "node --import tsx scripts/release-gate.mjs",
    "gate:release:full": "npm run gate:all && npm run gate:performance && npm run gate:system",
    "gate:merge": "node scripts/merge-gate.mjs",
    "gate:performance": "npm run frontend:route-gates",
    "ui:release": "node --import tsx scripts/browser-ui-release.mjs",
    "gate:shared-chat": "node --import tsx scripts/shared-chat-gate.mjs",
    "gate:a07": "node --import tsx --test scripts/a07-acceptance.test.mjs"
  },
  "devDependencies": {
    "@sislex/runner-contracts": "file:vendor/sislex-runner-contracts-0.1.1-1ccbdeb47b04.tgz",
    "@sislexa/billing": "file:vendor/sislexa-billing-1.2.2-54901a743aae.tgz",
    "@sislexa/identity": "file:vendor/sislexa-identity-1.4.2-0207bffe45ba.tgz",
    "@sislexa/image-studio": "file:vendor/sislexa-image-studio-1.1.2-c7a49a428d85.tgz",
    "@sislexa/make": "file:vendor/sislexa-make-1.3.1-3c3ab287e32c.tgz",
    "@sislexa/playwright-reader": "file:vendor/sislexa-playwright-reader-1.2.3-4e69a4482993.tgz",
    "@sislexa/sdk": "file:vendor/sislexa-sdk-1.2.0-354b8e560bac.tgz",
    "@sislexa/voice": "file:vendor/sislexa-voice-1.1.0-7e51e57ebf3b.tgz",
    "@sislexa/web-reader": "file:vendor/sislexa-web-reader-1.3.0-1ed1ef1fc219.tgz",
    "@vitest/coverage-v8": "2.1.9",
    "@voicechat/browser-contracts": "file:vendor/voicechat-browser-contracts-1.1.0-a06c73deaca8.tgz",
    "@voicechat/image-studio-contracts": "file:vendor/voicechat-image-studio-contracts-1.0.0-c7a49a428d85.tgz",
    "@voicechat/make-contracts": "file:vendor/voicechat-make-contracts-1.3.0-e227efe2abed.tgz",
    "@voicechat/playwright-reader-contracts": "file:vendor/voicechat-playwright-reader-contracts-1.2.0-13de7060b9f2.tgz",
    "@voicechat/ui-foundation": "file:vendor/voicechat-ui-foundation-0.1.8-e5b4ef76c06b-fcfeefb8a485.tgz",
    "@voicechat/ui-kit": "file:vendor/voicechat-ui-kit-0.1.3-ec8ba8f62d43.tgz",
    "@voicechat/voice-contracts": "file:vendor/voicechat-voice-contracts-1.0.0-7e51e57ebf3b.tgz",
    "@voicechat/web-reader-contracts": "file:vendor/voicechat-web-reader-contracts-1.3.0-b0f8c2174921.tgz",
    "@sislexa/agent-contracts": "file:vendor/sislexa-agent-contracts-1.0.0-5503ff1c0d12.tgz",
    "@sislexa/agent": "file:vendor/sislexa-agent-0.20.0-741682375796.tgz",
    "electron": "33.4.11",
    "@sislexa/desktop": "file:vendor/sislexa-desktop-1.0.12-6d64f79c0707.tgz",
    "@sislexa/core-ui": "file:vendor/sislexa-core-ui-1.4.9-529687987be0.tgz",
    "@sislexa/analytics": "file:vendor/sislexa-analytics-1.3.0-058c5ebed59f.tgz",
    "tar-stream": "2.2.0",
    "@sislexa/chat-ui": "file:vendor/sislexa-chat-ui-0.2.0-29f9fbf79e29.tgz",
    "@voicechat/chat-app": "file:vendor/voicechat-chat-app-0.2.0-29f9fbf79e29.tgz",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "@sislex/llm-runner": "file:vendor/sislex-llm-runner-0.3.5-1ccbdeb47b04.tgz"
  }
}
