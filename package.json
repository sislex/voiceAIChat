{
  "name": "voicechat-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Голосовой чат-бот: desktop (Electron), server (STT/TTS/Claude), web-клиент",
  "//": "desktop и agent-tray НЕ в workspaces намеренно: у них свой node_modules с Electron — корневой npm install их не трогает.",
  "workspaces": [
    "packages/*",
    "apps/llm-runner",
    "apps/server",
    "apps/web",
    "apps/agent"
  ],
  "scripts": {
    "dev:web": "bash scripts/dev-web.sh",
    "kb": "node scripts/kb.mjs",
    "kb:check": "node scripts/kb.mjs check",
    "kb:index": "node scripts/kb.mjs index",
    "kb:log": "node scripts/kb.mjs log",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "node --test scripts/affected-check.test.mjs && npm run test --workspaces --if-present",
    "affected-check": "node scripts/affected-check.mjs",
    "build": "npm run build --workspaces --if-present",
    "//storybook": "Смоук-сборка витрины: единственное, что ловит сломанную сториз — tsc её JSX проверяет, а рендер нет.",
    "build:storybook": "npm run -w @voicechat/ui build-storybook",
    "verify": "npm run typecheck && npm run test && npm run build && npm run build:storybook && npm run typecheck:desktop && npm run test:desktop && npm --prefix apps/desktop run build && npm run typecheck:agent-tray && npm run test:agent-tray",
    "typecheck:desktop": "npm --prefix apps/desktop run typecheck",
    "test:desktop": "npm --prefix apps/desktop run test",
    "typecheck:agent-tray": "npm --prefix apps/agent-tray run typecheck",
    "test:agent-tray": "npm --prefix apps/agent-tray run test",
    "dist:agent-tray": "npm --prefix apps/agent-tray run dist",
    "docker": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "kb:prepare": "node scripts/kb-search.mjs prepare",
    "kb:verify-prepared": "node scripts/kb-search.mjs verify",
    "kb:search": "node scripts/kb-search.mjs search",
    "kb:context": "node scripts/kb-search.mjs context",
    "kb:impact": "node scripts/kb-search.mjs impact"
  }
}
