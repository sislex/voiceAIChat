# Review ports before starting. Windows requires WSL.
SISLEXA_STAND_UI_PORT=25273
SISLEXA_STAND_PORT_BASE=28000
# PostgreSQL server URL WITHOUT a database, e.g. postgres://user:password@127.0.0.1:5432
# Empty starts a private postgres:17 Docker container.
SISLEXA_STAND_PG=
SISLEXA_STAND_USERS_PASSWORD=123
# Production Core model API base, e.g. https://sislexa.example/api/model-runner (without /v1).
# Uses the token user's production balance; model tools (Make, KB, Kanban MCP) are disabled.
SISLEXA_MODEL_API_URL=
SISLEXA_MODEL_API_TOKEN=
# Optional direct runner integration; ignored when the model API pair above is set.
VC_LLM_RUNNER_CLAUDE_URL=
VC_LLM_RUNNER_CODEX_URL=
VC_LLM_RUNNER_TOKEN=
