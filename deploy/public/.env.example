# Created by `npm run public:install`; secrets are generated there. Edit the non-secret values.
PUBLIC_DOMAIN=sislexa.by
# Public origin; keep the port when the HTTPS port is not 443.
PUBLIC_URL=https://sislexa.by
# Storage application host (needs its own DNS record).
PUBLIC_STORAGE_URL=https://files.sislexa.by
# Caddy sites (public:install fills them): a real domain uses Let's Encrypt.
PUBLIC_SITE=sislexa.by
PUBLIC_WWW_SITE=www.sislexa.by
PUBLIC_FILES_SITE=files.sislexa.by
PUBLIC_TLS_LINE=tls admin@sislexa.by
PUBLIC_HTTP_PORT=80
PUBLIC_HTTPS_PORT=443
# Absolute path of the private state directory (secrets, component tokens).
PUBLIC_STATE_DIR=/opt/sislexa-public/state
# sislex/storage checkout used to build the storage image.
PUBLIC_STORAGE_SOURCE=/opt/sislexa-public/storage
# Release version and commit Core reports to its peers (filled by public:install).
PUBLIC_CORE_VERSION=0.1.576
PUBLIC_CORE_COMMIT=
# Cheap models only (Codex terra and luna for now).
PUBLIC_CHAT_MODELS=codex:gpt-5.6-terra,codex:gpt-5.6-luna
# Free use with a daily limit per user: 100000 micro-USD = $0.10.
PUBLIC_DAILY_USER_MICRO_USD=100000
PUBLIC_TIME_ZONE=Europe/Minsk
# File storage quota per user (50 MB) and node capacity.
PUBLIC_STORAGE_QUOTA_BYTES=52428800
PUBLIC_STORAGE_CAPACITY_BYTES=20000000000
# LLM runner reachable from this server and its token.
PUBLIC_RUNNER_URL=http://runner.example:8790
PUBLIC_RUNNER_TOKEN=
# Outgoing mail for sign-up confirmation and password reset (smtp://user:pass@host:587).
PUBLIC_SMTP_URL=
PUBLIC_MAIL_FROM=Sislexa <no-reply@sislexa.by>
# Generated secrets.
PUBLIC_PG_PASSWORD=
PUBLIC_ADMIN_PASSWORD=
PUBLIC_INTERNAL_TOKEN=
PUBLIC_MCP_SECRET=
PUBLIC_STORAGE_APP_TOKEN=
