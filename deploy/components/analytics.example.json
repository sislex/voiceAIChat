{
  "schemaVersion": 1,
  "environmentId": "production",
  "registryDirectory": "/run/sislexa/provider",
  "legacyScopes": [],
  "grants": [
    {
      "consumerId": "core",
      "scopes": ["analytics.activity", "analytics.report"],
      "maxTtlSeconds": 2592000
    }
  ],
  "dependencies": [
    {
      "applicationId": "identity",
      "url": "http://identity:8798",
      "tokenFile": "/run/sislexa/outgoing/identity.token"
    },
    {
      "applicationId": "billing",
      "url": "http://billing:8800",
      "tokenFile": "/run/sislexa/outgoing/billing.token"
    }
  ]
}
