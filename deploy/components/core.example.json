{
  "schemaVersion": 1,
  "environmentId": "production",
  "registryDirectory": "/run/sislexa/provider",
  "grants": [
    {
      "consumerId": "make",
      "scopes": [
        "identity.verify",
        "make.core",
        "make.events"
      ],
      "maxTtlSeconds": 2592000
    },
    {
      "consumerId": "playwright-reader",
      "scopes": [
        "identity.verify",
        "playwright-reader.core"
      ],
      "maxTtlSeconds": 2592000
    },
    {
      "consumerId": "web-reader",
      "scopes": [
        "identity.verify",
        "reader.core"
      ],
      "maxTtlSeconds": 2592000
    },
    {
      "consumerId": "image-studio",
      "scopes": [
        "identity.verify",
        "image-studio.core",
        "image-studio.generate"
      ],
      "maxTtlSeconds": 2592000
    },
    {
      "consumerId": "identity",
      "scopes": [
        "identity.core"
      ],
      "maxTtlSeconds": 2592000
    }
  ],
  "legacyScopes": [
    "identity.verify"
  ],
  "dependencies": [
    {
      "applicationId": "make",
      "url": "http://make:8788",
      "tokenFile": "/run/sislexa/outgoing/make.token"
    },
    {
      "applicationId": "playwright-reader",
      "url": "http://playwright-reader:8797",
      "tokenFile": "/run/sislexa/outgoing/playwright-reader.token"
    },
    {
      "applicationId": "web-reader",
      "url": "http://reader:8795",
      "tokenFile": "/run/sislexa/outgoing/web-reader.token"
    },
    {
      "applicationId": "image-studio",
      "url": "http://image-studio:8796",
      "tokenFile": "/run/sislexa/outgoing/image-studio.token"
    },
    {
      "applicationId": "stt-runner",
      "url": "http://stt-runner:8791",
      "tokenFile": "/run/sislexa/outgoing/stt-runner.token"
    },
    {
      "applicationId": "tts-runner",
      "url": "http://tts-runner:8791",
      "tokenFile": "/run/sislexa/outgoing/tts-runner.token"
    },
    {
      "applicationId": "identity",
      "url": "http://identity:8798",
      "tokenFile": "/run/sislexa/outgoing/identity.token"
    }
  ]
}
