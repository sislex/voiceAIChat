[Unit]
Description=Renew Sislexa component grants daily before they expire

[Timer]
# Renewal restarts the affected consumers, so it runs once a day at a quiet hour.
OnCalendar=*-*-* 03:30:00 UTC
Persistent=true
RandomizedDelaySec=300
Unit=voicechat-component-rotation.service

[Install]
WantedBy=timers.target
