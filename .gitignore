# Зависимости
node_modules/

# Сборка
out/
dist/
build/
release/
*.tsbuildinfo

# Кэши/покрытие
.vite/
.cache/
coverage/
artifacts/

# Логи и мусор ОС
*.log
.DS_Store

# Окружение
.env
.env.*

# Python-венв Piper
.venv-piper/
.venv/

# Тяжёлые ассеты (модели/голоса/рантаймы) — качаются, не в гит
/models/
!/models/.gitkeep
**/resources/piper-runtime/
**/resources/piper-voices/

# Дублирующая защита от тяжёлых бинарей моделей/голосов и локальных БД
*.bin
*.onnx
*.onnx.json
*.db
*.sqlite
*.sqlite3

# Скачанный бандл компаньон-агента (собирается сервером на лету, не в гит)
voicechat-agent.cjs
voicechat-agent.cjs.*
voicechat-agent.*.cjs

# Картинки, созданные моделью: агент раздаёт их из своего rootDir по HTTP, а на
# машине-сервере этот rootDir — сам репозиторий (см. docs/kb/machines.md).
.generated_images/

# Скриншоты для обсуждения (не часть кодовой базы)
scrins/

# Личные разрешения агентов — у каждой машины свои. Сами команды и скиллы
# (.claude/commands/**) наоборот коммитятся: они нужны всем агентам.
**/.claude/settings.local.json
storybook-static/
