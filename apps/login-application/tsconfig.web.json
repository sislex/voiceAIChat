{
  "compilerOptions": {
    // Инкрементальный typecheck: tsc держит tsconfig.tsbuildinfo рядом с конфигом
    // (он в .gitignore) и на тёплом кеше отвечает за секунду вместо десяти.
    "incremental": true,
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["../../packages/shared/src/*"]
    }
  },
  "include": ["src/renderer/**/*.ts"]
}
