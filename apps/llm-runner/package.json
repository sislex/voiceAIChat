{
  "name": "@voicechat/llm-runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "//": "Как и сервер, не компилируется в JS: запуск через tsx из исходников, относительные импорты — с .js",
  "exports": {
    ".": "./src/server.ts",
    "./cli": "./src/cli/index.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --silent"
  },
  "dependencies": {
    "@voicechat/shared": "*",
    "fastify": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
